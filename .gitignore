node_modules/
.env
*.p12
*.p8
*.log
.DS_Store
credentials/
# Downloaded Apple signing material (.p12/.p8, the CSR, and the plaintext
# password note). These live in Railway's Variables UI, never in the repo —
# ignored as a whole folder so a `git add -A` can't sweep them in.
apple_certs/
*.certSigningRequest
*-pw.txt
# The public Apple WWDR cert (certs/wwdr.pem) IS committed on purpose.
# Screenshots and screen recordings kept alongside the project. Not source, and
# a single .mov is bigger than the whole repo — one nearly went in at 91 MB
# because `git add -A` sweeps whatever is sitting there.
sreenshots/
screenshots/
*.mov
# The same rule, for where those files live now. images/ was reorganised out of
# sreenshots/ and brand/, and the two folders below hold 123 MB of competitor
# recordings and the pitch video — reference material, not source. The .mov rule
# above already caught the two big ones; these catch the rest, so a stray
# `git add -A` can never sweep them into history where they cannot be removed.
#
# images/img assets/ and images/brand/ are NOT ignored on purpose: those are the
# originals the site's artwork in assets/img/ is processed from, and losing them
# would mean losing the only copy that can be re-cropped or re-exported.
images/references/
images/videos/
